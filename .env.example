# Copy to .env.local for local development. Never commit real values.
# Vercel: set the same names in Project Settings > Environment Variables.

# Public (sent to the browser). The Charming Ride Supabase project is shared;
# ml-driving-game lives in its own schema `mlgame`.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Where the game is embedded from. Default: the deployed speedy-deliveries.
# For local work against a local game: http://localhost:8080/game
# VITE_GAME_URL="https://speedy-deliveries-theta.vercel.app/game"

# Server only (used by /api/join). NEVER prefix these with VITE_.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
